{
  "arch": "wasm64",
  "binary-format": "wasm",
  "data-layout": "e-m:e-p:64:64-p10:8:8-p20:8:8-i64:64-i128:128-f128:64-n32:64-S128-ni:1:10:20",
  "eh-frame-header": false,
  "emit-debug-gdb-scripts": false,
  "entry-name": "__main_argc_argv",
  "exe-suffix": "",
  "features": "+atomics,+bulk-memory,+mutable-globals,+sign-ext,+nontrapping-fptoint,+multivalue,+reference-types,+simd128",
  "generate-arange-section": false,
  "has-thread-local": false,
  "is-like-wasm": true,
  "linker": "obsd-rust-ld",
  "linker-flavor": "wasm-lld",
  "lld-flavor": "wasm",
  "llvm-target": "wasm64-unknown-emscripten",
  "main-needs-argc-argv": true,
  "max-atomic-width": 64,
  "os": "openbsd",
  "panic-strategy": "abort",
  "relocation-model": "static",
  "target-family": [
    "unix"
  ],
  "target-pointer-width": 64,
  "tls-model": "emulated"
}
