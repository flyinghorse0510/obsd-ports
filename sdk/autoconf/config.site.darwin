# sdk/autoconf/config.site.darwin -- GNU Autoconf & gnulib cross-compilation
# cache for OpenBSD 7.8 / 7.9 / 8.0 LP64 arm64 on Darwin (`translate` & `emulate`).
#
# Loaded via `CONFIG_SITE=<repo>/sdk/autoconf/config.site.darwin` when
# `./configure --host=aarch64-unknown-openbsd<ver>` runs so cross-compile tests
# never execute guest/iOS binaries on the host and never probe runtime dlopen().

cross_compiling=yes

# Architecture & LP64 data model (arm64 little-endian == OpenBSD LP64)
ac_cv_c_bigendian=no
ac_cv_sizeof_char=1
ac_cv_sizeof_short=2
ac_cv_sizeof_int=4
ac_cv_sizeof_long=8
ac_cv_sizeof_long_long=8
ac_cv_sizeof_void_p=8
ac_cv_sizeof_size_t=8
ac_cv_sizeof_ssize_t=8
ac_cv_sizeof_ptrdiff_t=8
ac_cv_sizeof_intptr_t=8
ac_cv_sizeof_uintptr_t=8
ac_cv_sizeof_off_t=8
ac_cv_sizeof_time_t=8
ac_cv_sizeof_intmax_t=8
ac_cv_sizeof_uintmax_t=8

# OpenBSD libc runtime guarantees
ac_cv_func_malloc_0_nonnull=yes
ac_cv_func_realloc_0_nonnull=yes
ac_cv_func_calloc_0_nonnull=yes
ac_cv_func_mmap_fixed_mapped=yes
ac_cv_func_working_mktime=yes
ac_cv_func_getaddrinfo=yes
ac_cv_func_fork_works=yes
ac_cv_func_vfork_works=yes
ac_cv_func_chown_works=yes
ac_cv_func_lstat_dereferences_slashed_symlink=yes
ac_cv_func_stat_empty_string_bug=no
ac_cv_func_lstat_empty_string_bug=no
ac_cv_func_strerror_r_char_p=no
ac_cv_have_decl_strerror_r=yes

# Static guest policy: never enable runtime dlopen() plugin/extension loaders
ac_cv_func_dlopen=no
ac_cv_lib_dl_dlopen=no
ac_cv_search_dlopen=no
ac_cv_header_dlfcn_h=no

# Authentic OpenBSD guest filesystem paths
ac_cv_file__dev_urandom=yes
ac_cv_file__dev_random=yes
ac_cv_file__dev_zero=yes
ac_cv_file__dev_null=yes
ac_cv_file__etc_ssl_cert_pem=yes

# curl cross-compilation runtime probes
curl_cv_writable_argv=yes
curl_cv_recv=yes
curl_cv_send=yes
curl_cv_func_recv_args="int,void *,size_t,int,ssize_t"
curl_cv_func_send_args="int,const void *,size_t,int,ssize_t"

# gnulib cross-compilation runtime probes
gl_cv_host_cpu_c_abi=arm64
gl_cv_func_printf_sizes_c99=yes
gl_cv_func_printf_long_double=yes
gl_cv_func_printf_infinite=yes
gl_cv_func_printf_infinite_long_double=yes
gl_cv_func_printf_directive_a=yes
gl_cv_func_printf_directive_f=yes
gl_cv_func_printf_directive_ls=yes
gl_cv_func_printf_directive_n=no
gl_cv_func_printf_positions=yes
gl_cv_func_printf_flag_grouping=yes
gl_cv_func_printf_flag_leftadjust=yes
gl_cv_func_printf_flag_zero=yes
gl_cv_func_printf_precision=yes
gl_cv_func_printf_enomem=yes
gl_cv_func_snprintf_truncation_c99=yes
gl_cv_func_snprintf_retval_c99=yes
gl_cv_func_snprintf_directive_n=no
gl_cv_func_snprintf_size1=yes
gl_cv_func_vsnprintf_zerosize_c99=yes
gl_cv_func_getcwd_null=yes
gl_cv_func_getcwd_path_max=yes
gl_cv_func_getcwd_abort_bug=no
gl_cv_func_malloc_posix=yes
gl_cv_func_calloc_0_nonnull=yes
gl_cv_func_realloc_0_nonnull=yes
gl_cv_func_realloc_posix=yes
gl_cv_func_wcwidth_works=yes
gl_cv_func_mbrtowc_empty_input=yes
gl_cv_func_mbrtowc_incomplete_state=yes
gl_cv_func_mbrtowc_sanitycheck=yes
gl_cv_func_mbrtowc_null_arg1=yes
gl_cv_func_mbrtowc_null_arg2=yes
gl_cv_func_mbrtowc_retval=yes
gl_cv_func_mbrtowc_nul_retval=yes
gl_cv_func_btowc_eof=yes
gl_cv_func_fcntl_f_dupfd_works=yes
gl_cv_func_fcntl_f_dupfd_cloexec=yes
gl_cv_func_open_directory_works=yes
gl_cv_func_fdopendir_works=yes
gl_cv_func_gettimeofday_clobber=no
gl_cv_func_nanosleep=yes
gl_cv_func_sigprocmask=1
gl_cv_func_working_utimes=yes
gl_cv_func_futimens_works=yes
gl_cv_func_utimensat_works=yes
