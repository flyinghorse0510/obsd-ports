COMPAT_BACKEND ?= emulate
COMPAT_PAL ?= emscripten

MATRIX_MANIFEST := $(CONFIG_ROOT)/matrix/index.tsv
BACKEND_FRAGMENT := $(CONFIG_ROOT)/matrix/backends/$(COMPAT_BACKEND).mk
PAL_FRAGMENT := $(CONFIG_ROOT)/matrix/pals/$(COMPAT_PAL).mk

ifeq ($(wildcard $(BACKEND_FRAGMENT)),)
$(error Unsupported COMPAT_BACKEND='$(COMPAT_BACKEND)'. Declared backends live in $(MATRIX_MANIFEST))
endif

ifeq ($(wildcard $(PAL_FRAGMENT)),)
$(error Unsupported COMPAT_PAL='$(COMPAT_PAL)'. Declared PALs live in $(MATRIX_MANIFEST))
endif

include $(BACKEND_FRAGMENT)
include $(PAL_FRAGMENT)
MAKEFILE_CONFIG_FRAGMENTS += $(BACKEND_FRAGMENT) $(PAL_FRAGMENT)

COMPAT_SDK ?=
COMPAT_LANE_LEAF ?= $(COMPAT_PAL)

LANE_REL_DIR := openbsd/$(OPENBSD_VERSION)/$(COMPAT_BACKEND)/$(COMPAT_LANE_LEAF)
LANE_BUILD_DIR := $(BUILD_ROOT)/$(LANE_REL_DIR)
LANE_STAGE_DIR := $(LANE_BUILD_DIR)/stage
LANE_SYSROOT_DIR := $(LANE_BUILD_DIR)/sysroot
LANE_WORK_DIR := $(LANE_BUILD_DIR)/work
LANE_APPLETS_DIR := $(LANE_BUILD_DIR)/applets
LANE_PACKAGES_DIR := $(LANE_BUILD_DIR)/packages
TARGET_ADAPTER_DIR := $(TARGETS_ROOT)/$(COMPAT_BACKEND)/$(COMPAT_PAL)
