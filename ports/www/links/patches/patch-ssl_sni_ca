Enable TLS SNI (SSL_set_tlsext_host_name), peer hostname verification
(SSL_set1_host), and /etc/ssl/cert.pem CA bundle loading in links 1.03
so modern HTTPS endpoints (e.g. https://example.com) verify cleanly.

--- https.c.orig
+++ https.c
@@ -38,7 +38,9 @@
 		SSLeay_add_ssl_algorithms();
 		context = SSL_CTX_new(SSLv23_client_method());
 		SSL_CTX_set_options(context, SSL_OP_ALL);
+		SSL_CTX_load_verify_locations(context, "/etc/ssl/cert.pem", NULL);
 		SSL_CTX_set_default_verify_paths(context);
+		SSL_CTX_set_verify(context, SSL_VERIFY_PEER, NULL);
 /* needed for systems without /dev/random, but obviously kills security. */
